{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yumi continuity revision ledger",
  "description": "A bounded, offline one-scope revision ledger. source_ref is opaque data.",
  "type": "object",
  "required": ["scope", "revisions"],
  "properties": {
    "schema": {"type": "string"},
    "scope": {"type": "string", "minLength": 1, "maxLength": 4096},
    "heads": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "uniqueItems": true
    },
    "prior_heads": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "uniqueItems": true
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/revision"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "referenceList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 4096},
      "uniqueItems": true
    },
    "assertion": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "assertion_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "name": {"type": "string", "minLength": 1, "maxLength": 4096},
        "state": {"enum": ["asserted", "assert", "set", "active", "retracted", "retract", "withdraw", "withdrawn"]},
        "status": {"type": "string"},
        "op": {"type": "string"},
        "value": {},
        "target": {"type": "string", "minLength": 1, "maxLength": 4096},
        "reason": {"type": "string", "maxLength": 4096},
        "supersedes": {"$ref": "#/$defs/referenceList"},
        "source_label": {"type": "string", "maxLength": 4096},
        "source": {"type": "string", "maxLength": 4096},
        "source_ref": {"type": "string", "maxLength": 4096}
      },
      "additionalProperties": true
    },
    "revision": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "parent": {"type": ["string", "null"], "maxLength": 256},
        "parent_id": {"type": ["string", "null"], "maxLength": 256},
        "sequence": {"type": "integer"},
        "supersedes": {"$ref": "#/$defs/referenceList"},
        "retracts": {"$ref": "#/$defs/referenceList"},
        "retractions": {"$ref": "#/$defs/referenceList"},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "source_label": {"type": "string", "maxLength": 4096},
        "source": {"type": "string", "maxLength": 4096},
        "source_ref": {"type": "string", "maxLength": 4096}
      },
      "additionalProperties": true
    }
  }
}
